# Copy to `.env` for local dev, or set these as environment variables on Render.
# NEVER commit the real .env (it's gitignored).

# --- Required in production ---
# MongoDB Atlas connection string (Database → Connect → Drivers). Put your DB
# user's password in place of <password> and add the DB name before the '?'.
MONGO_URI=mongodb+srv://sehatline:<password>@cluster0.xxxxx.mongodb.net/SehatLineApp?retryWrites=true&w=majority

# Strong random secret (32+ chars). On Render this is auto-generated; for local
# dev generate one, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Sensible defaults (override if needed) ---
NODE_ENV=production
PORT=5000                 # Render injects its own PORT; leave for local dev
JWT_EXPIRES_IN=7d
SESSION_INACTIVITY_MINUTES=5
ML_AUTOSTART=false        # no Python ML service on the hosted Node server

# --- Optional: password-reset emails (Gmail app password) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_APP_PASSWORD=
EMAIL_FROM=SehatLine <no-reply@sehatline.app>
